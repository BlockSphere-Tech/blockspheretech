{
  "name": "cryptara",
  "version": "1.0.0",
  "private": true,
  "description": "Cryptara — enterprise blockchain infrastructure",
  "scripts": {
    "dev": "concurrently -n api,web -c teal,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm start --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "cryptara",
    "blockchain",
    "nextjs",
    "express"
  ],
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
